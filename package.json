{
  "name": "contentflow-cms",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "lint": "npm run lint --prefix client && npm run lint --prefix server",
    "format": "prettier --write \"{client,server}/**/*.{ts,tsx,js,json,css,md}\"",
    "format:check": "prettier --check \"{client,server}/**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "prettier": "^3.7.4"
  }
}
